
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 4

[*.{f90,f95,f03,f08,F90,F95}]
indent_size = 4

[*.{gpr,adb,ads}]
indent_size = 4

[*.cmake]
indent_size = 4

[CMakeLists.txt]
indent_size = 4
